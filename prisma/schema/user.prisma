model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  password         String
  profileImage     String?
  role             Roles           @default(TENANT)
  status           UserStatus      @default(ACTIVE)
  phone            String?
  avatar           String?
  address          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  properties       Property[]
  landlordRequests RentalRequest[] @relation("landlordRequests")
  tenantRequests   RentalRequest[] @relation("tenantRequests")
  reviews          Review[]

  @@map("users")
}

enum Roles {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}
